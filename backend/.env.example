# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/atom_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=15m

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Consola: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ─────────────────────────────────────────────────────────────
# Panel: https://developers.facebook.com → My Apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Flutter deep-link scheme (para redirigir tras OAuth) ───────────────────────
APP_SCHEME=atom

# ── CORS (orígenes permitidos separados por coma) ──────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
